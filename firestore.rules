rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────
    // Helpers
    // ─────────────────────────────────────────────

    function signedIn() {
      return request.auth != null;
    }

    function isMember(diaryId) {
      return signedIn()
        && exists(
          /databases/$(database)/documents/diaries/$(diaryId)/members/$(request.auth.uid)
        );
    }

    function isCallParticipant(diaryId, callId) {
      return isMember(diaryId)
        && (
          get(
            /databases/$(database)/documents/diaries/$(diaryId)/calls/$(callId)
          ).data.callerUid == request.auth.uid
          ||
          get(
            /databases/$(database)/documents/diaries/$(diaryId)/calls/$(callId)
          ).data.calleeUid == request.auth.uid
        );
    }


    // ─────────────────────────────────────────────
    // Diary
    // ─────────────────────────────────────────────

    match /diaries/{diaryId} {

      // اطلاعات اصلی دفترچه مستقیماً قابل دسترسی نیست.
      allow read, write: if false;


      // ─────────────────────────────────────────
      // Members
      // ─────────────────────────────────────────

      match /members/{uid} {

        // ثبت عضو
        allow create:
          if signedIn()
          && request.auth.uid == uid
          && !exists(
            /databases/$(database)/documents/diaries/$(diaryId)/members/$(uid)
          )
          && request.resource.data.uid == uid
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 100;

        // مشاهده اعضا
        allow read:
          if isMember(diaryId)
          || (
            signedIn()
            && request.auth.uid == uid
          );

        // ویرایش اطلاعات خود
        allow update:
          if isMember(diaryId)
          && request.auth.uid == uid
          && request.resource.data.uid == resource.data.uid;

        // حذف عضو از کلاینت ممنوع
        allow delete: if false;
      }


      // ─────────────────────────────────────────
      // Messages / Chat
      // ─────────────────────────────────────────

      match /messages/{messageId} {

        // خواندن پیام‌ها
        allow read:
          if isMember(diaryId);

        // ارسال پیام
        allow create:
          if isMember(diaryId)
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() > 0
          && request.resource.data.senderName.size() <= 100
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;

        // ویرایش پیام خود
        allow update:
          if isMember(diaryId)
          && resource.data.senderUid == request.auth.uid
          && request.resource.data.senderUid == resource.data.senderUid;

        // حذف پیام خود
        allow delete:
          if isMember(diaryId)
          && resource.data.senderUid == request.auth.uid;
      }


      // ─────────────────────────────────────────
      // Diary Entries
      // ─────────────────────────────────────────

      match /entries/{entryId} {

        // مشاهده خاطرات
        allow read:
          if isMember(diaryId);

        // ایجاد خاطره
        allow create:
          if isMember(diaryId)
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 10000;

        // ویرایش خاطره خود
        allow update:
          if isMember(diaryId)
          && resource.data.authorUid == request.auth.uid
          && request.resource.data.authorUid == resource.data.authorUid;

        // حذف خاطره خود
        allow delete:
          if isMember(diaryId)
          && resource.data.authorUid == request.auth.uid;
      }


      // ─────────────────────────────────────────
      // Calls
      // ─────────────────────────────────────────

      match /calls/{callId} {

        // ایجاد تماس
        allow create:
          if isMember(diaryId)
          && request.resource.data.callerUid == request.auth.uid
          && request.resource.data.callerName is string
          && request.resource.data.callerName.size() > 0
          && request.resource.data.callerName.size() <= 100
          && request.resource.data.calleeUid is string
          && request.resource.data.type in ['audio', 'video']
          && request.resource.data.status == 'ringing';

        // مشاهده تماس
        allow read:
          if isCallParticipant(diaryId, callId);

        // تغییر وضعیت تماس
        allow update:
          if isCallParticipant(diaryId, callId);

        // حذف تماس
        allow delete:
          if isCallParticipant(diaryId, callId);


        // ─────────────────────────────────────
        // Caller ICE Candidates
        // ─────────────────────────────────────

        match /callerCandidates/{candidateId} {

          allow create:
            if isCallParticipant(diaryId, callId);

          allow read:
            if isCallParticipant(diaryId, callId);

          allow delete:
            if isCallParticipant(diaryId, callId);

          allow update: if false;
        }


        // ─────────────────────────────────────
        // Callee ICE Candidates
        // ─────────────────────────────────────

        match /calleeCandidates/{candidateId} {

          allow create:
            if isCallParticipant(diaryId, callId);

          allow read:
            if isCallParticipant(diaryId, callId);

          allow delete:
            if isCallParticipant(diaryId, callId);

          allow update: if false;
        }
      }
    }
  }
}
